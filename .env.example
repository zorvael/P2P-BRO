# Optional PeerJS signaling server. Leave unset to use the public PeerJS broker.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/peerjs
# VITE_PEER_SECURE=true

# Optional Cloudflare Worker URL for the encrypted offline inbox and public Global Chat.
# VITE_INBOX_API_URL=https://near-offline-inbox.<your-subdomain>.workers.dev

# Optional STUN/TURN servers for networks where direct WebRTC fails.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
